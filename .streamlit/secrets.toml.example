# ============================================================
# secrets.toml.example — Streamlit Secrets Configuration
# ============================================================
# Copy this file to:   frontend/.streamlit/secrets.toml
# (that path is already listed in .gitignore)
# NEVER commit the real secrets.toml file.
#
# Streamlit will make these values available via st.secrets.
# The dashboard reads GOOGLE_PLACES_API_KEY automatically
# so users don't need to paste their key into the UI each session.

GOOGLE_PLACES_API_KEY = "your_google_places_api_key_here"
