# ============================================================
# .env.example — Local Development Environment Variables
# ============================================================
# Copy this file to .env (which is already in .gitignore).
# The .env file is loaded automatically by uvicorn / your shell.
# NEVER commit the real .env file.

# Google Places API (New) key.
# Required for Live Google Review Analysis in the dashboard.
# Get a key at: https://console.cloud.google.com/apis/credentials
# Enable: "Places API (New)" on the same project.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
