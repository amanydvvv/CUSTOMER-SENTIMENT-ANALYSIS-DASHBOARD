PROJECT_NAME="Customer Sentiment Analysis Dashboard (PRJ_382)"
API_V1_STR=/api/v1
SECRET_KEY=secret-jwt-key-prj382-sentiment-super-secure-token-2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection (Default SQLite, or set to PostgreSQL)
DATABASE_URL=sqlite:///sentiment_analytics.db
# DATABASE_URL=postgresql://user:password@localhost:5432/sentiment_db

# Model SLAs & Benchmarks
DISTILBERT_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
TRANSFORMER_TIMEOUT_MS=250.0
FALLBACK_TIMEOUT_MS=30.0
TARGET_MACRO_F1=0.88
